# Monad MAINNET (143) env profile for the keeper, the MMs and the watcher (Phase 3 P4). VARIABLE NAMES ONLY:
# copy to a gitignored file per process (e.g. keepers/.env.keeper-143), fill the values from the team's secret store,
# and `set -a; source <file>; set +a` in that process's own terminal. Never commit values. KEYS: one per process.
# Values that are public facts are named, not filled, so this file can never drift from deployments/143.json.
# Order on mainnet day: keeper → perp MM → swap MM → (wait ≥ 30 s) → watcher (RUNBOOK §2, §8).

# ── shared (every process) ──────────────────────────────────────────────────────────────────────────────────────────
CHAIN_ID=                     # 143
DEPLOYMENTS=                  # absolute path to deployments/143.json (written by the real broadcast; NOT dry-run/)
LOG_SPAN=                     # eth_getLogs chunk for this process's RPC tier (public: 100; check the paid tier's limit)

# ── keeper (keepers/ts-fallback, `pnpm start`) ─────────────────────────────────────────────────────────────────────
RPC_URL=                      # the keeper's OWN paid endpoint (HUMAN_CHECKLIST #5); B7 ≤ 3 blocks needs it
KEEPER_PK=                    # keeper hot key (HUMAN_CHECKLIST #4); = KEEPER_ADDRESS given to DeployMeridian
HEALTH_PORT=                  # 8797 (8787 is taken on the lead's machine)
ORACLE_KIND=                  # leave empty: "pyth" comes from deployments/143.json
PYTH_API_KEY=                 # Hermes key (HUMAN_CHECKLIST #6); empty ⇒ the keeper pushes nothing, sponsored pushes only
PYTH_MON_USD_FEED_ID=         # ARCHITECTURE R12
INCLUSION_LAG_BLOCKS=         # 2 default off 10143; re-measure on 143 in the first hour (funding gap ≤ 20 blocks)
VAULT_REBALANCE=              # 1 (idle vault: needsRebalance() is None, so it sends nothing until skewCapacity > 0)
VAULT_ROUTE=                  # direct (idle launch); "flow" only after CR-010 + KURU_FLOW_JWT/KURU_API_KEY
SWAP_DUTIES=                  # empty = on (FundingSwapMarket in deployments)
SWAP_MARK_POKE_EVERY_BLOCKS=  # 20 (= MARK_MAX_ELAPSED_BLOCKS, decision 18)
FULL_SWEEP_EVERY_BLOCKS=      # 50 default
LOOKBACK_BLOCKS=              # small: the deployment's startBlock is recent

# ── perp MM (mm-bot, MARKET=main) ──────────────────────────────────────────────────────────────────────────────────
# RPC_URL=                    # the perp MM's OWN endpoint (not the keeper's)
MM_PK=                        # perp MM hot key = MM_ADDRESS given to DeployMeridian (registered skew provider, decision 11)
MARKET=                       # main
KILL_FILE=                    # absolute path, e.g. $HOME/meridian/KILL-perp
MAX_INVENTORY_LOTS=           # 200 default = 20,000 MON < maxPositionSize 25,000 MON (P3 finding F-3: never at the cap)
LEVELS=
LOTS_PER_LEVEL=
REQUOTE_BPS=
TICK_EVERY_BLOCKS=            # 1 on a paid endpoint; 2–3 to save MON (Monad bills the limit)
ESTIMATE_BLOCK_TAG=           # > VERIFY Monad's eth_estimateGas "pending" semantics (RUNBOOK §1); "latest" + TOUCH_ALLOWANCE_GAS otherwise
RECOVER_LOOKBACK_BLOCKS=

# ── swap MM (mm-bot, MARKET=swap; its OWN key and swap-market collateral) ──────────────────────────────────────────
# Use keepers/143.swap-mm.env.example for this process: it has the launch values filled (D13); mm-bot refuses
# REQUOTE_BPS < 1000 for MARKET=swap on 143 unless ALLOW_HIGH_BURN=1. The lines below are kept for reference.
# MM_PK=                      # swap MM hot key (different from the perp MM)
# MARKET=                     # swap
# KILL_FILE=                  # e.g. $HOME/meridian/KILL-swap
# REQUOTE_BPS=                # 1000 for the swap MM (APR bps; the default 2 cost ≈ 441 MON/h on the fork, RUNBOOK §4)
# TICK_EVERY_BLOCKS=          # 33 (≈ 10 s at 300 ms) for the swap MM
# LEVELS=                     # 1 for the swap MM at launch
SWAP_INVENTORY_FRACTION_BPS=  # 8000 default
SWAP_SIGMA_BPS=               # 1 APR bp/√s fallback (operator choice)

# ── watcher (keepers/ts-fallback, `pnpm watch`; start ≥ 30 s after the keeper) ─────────────────────────────────────
# RPC_URL=                    # the watcher's OWN endpoint
KEEPER_HEALTH=                # http://localhost:8797/health
WATCH_BALANCES=               # deployer=<addr>:2,keeper=<addr>:<floor>,mm=<addr>:<floor>,mmswap=<addr>:<floor> (floor = MON/h × 12 h)
WATCH_MM=                     # perp=<perp MM addr>,swap=<swap MM addr>
CHAINLINK_AUSD_USD=           # ARCHITECTURE R11
CHAINLINK_MON_USD=            # ARCHITECTURE R11
INDEXER_LAG_URL=              # > VERIFY the Envio endpoint (lane C hand-off) before wiring it
PAGE_LABEL=                   # e.g. "Meridian 143"
PAGE_DISCORD_WEBHOOK_URL=     # ONE channel: Discord webhook, OR the two Telegram vars below (secret; .env only)
PAGE_TELEGRAM_BOT_TOKEN=
PAGE_TELEGRAM_CHAT_ID=
# PAGE_LOCAL_WEBHOOK_URL is a REHEARSAL STAND-IN (localhost receiver): never set it on mainnet day.
