# Monad MAINNET (143) env profile for the SWAP market maker (mm-bot, MARKET=swap). PHASES decision D13 / Phase 3 F-5.
# The launch values below are config, not secrets, so they are filled. Keys and URLs stay empty: fill them from the
# team's secret store in a gitignored copy (e.g. keepers/.env.swapmm-143), never commit values.
# mm-bot refuses MARKET=swap on chain 143 with REQUOTE_BPS < 1000 unless ALLOW_HIGH_BURN=1 (mm-bot/src/launch.ts):
# the defaults burned ≈ 441 MON/h on the mainnet fork (RUNBOOK §4). The perp MM keeps its defaults (143.env.example).
CHAIN_ID=143
DEPLOYMENTS=                  # absolute path to deployments/143.json (written by the real broadcast; NOT dry-run/)
RPC_URL=                      # the swap MM's OWN endpoint (HUMAN_CHECKLIST #5)
LOG_SPAN=                     # eth_getLogs chunk for this RPC tier (public: 100)
MM_PK=                        # swap MM hot key (HUMAN_CHECKLIST #4), different from the perp MM
KILL_FILE=                    # absolute path, e.g. $HOME/meridian/KILL-swap
MARKET=swap
REQUOTE_BPS=1000              # APR bps; launch value (guarded)
TICK_EVERY_BLOCKS=33          # ≈ 10 s at ~300 ms blocks
LEVELS=1
SWAP_INVENTORY_FRACTION_BPS=  # 8000 default
SWAP_SIGMA_BPS=               # 1 APR bp/√s fallback (operator choice)
ESTIMATE_BLOCK_TAG=           # > VERIFY Monad's eth_estimateGas "pending" semantics (RUNBOOK §1)
# ALLOW_HIGH_BURN=            # never on mainnet day; 1 lifts the REQUOTE_BPS guard (cost ≈ 441 MON/h at REQUOTE_BPS=2)
