{
  "name": "@meridian/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Meridian money logic shared by the native app (and later the web app and bots): Perpl auth/WS/onboarding, key derivation, dual-book routing, basis, exec state machines, Meridian ABIs + deployment readers. Pure, Hermes-safe TypeScript (MOBILE_PLAN N1)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./perpl": "./src/perpl/index.ts",
    "./keys": "./src/keys/index.ts",
    "./route": "./src/route/index.ts",
    "./exec": "./src/exec/index.ts",
    "./meridian": "./src/meridian/index.ts",
    "./util": "./src/util/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "record:books": "tsx scripts/record-books.ts"
  },
  "dependencies": {
    "@meridian/abis": "workspace:*",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "1.8.0",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "viem": "2.57.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
