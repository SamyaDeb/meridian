# Copy to .env.local. Never hard-code RPC URLs (CONTRIBUTING.md §7).
NEXT_PUBLIC_MONAD_RPC_URL=
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# Indexer GraphQL (from CP1; see ws-06-indexer indexer/SCHEMA.md)
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_DATA_SOURCE=
NEXT_PUBLIC_CHAIN_ID=31337
# testnet: public RPC caps eth_getLogs at 100 blocks, Alchemy free tier at 10
NEXT_PUBLIC_LOG_SPAN=
NEXT_PUBLIC_LOG_LOOKBACK=
# Local full-stack rehearsal (Phase 4): an anvil started with --chain-id 10143. LOCAL_CHAIN_ID=10143 replaces
# monadTestnet in the wagmi config (no connector can reach the public testnet RPC), and the deployment override
# (the JSON of deployments/anvil-10143.json) replaces the bundled testnet record for this build only.
# NEXT_PUBLIC_LOCAL_CHAIN_ID=10143
# NEXT_PUBLIC_DEPLOYMENT_OVERRIDE='{"chainId":10143,...}'
# Restricted jurisdictions (C3, src/proxy.ts; server-side, NOT NEXT_PUBLIC). Unset header ⇒ no geo check.
# > VERIFY: the country header name for the hosting platform (its official docs) before setting GEO_COUNTRY_HEADER.
# The country list is decided by the founders (ISO 3166-1 alpha-2, comma-separated). Mode: writes (default) | all.
GEO_COUNTRY_HEADER=
GEO_BLOCKED_COUNTRIES=
GEO_BLOCK_MODE=writes
# Mainnet vault while the Kuru Flow spot route isn't live (B4 / review A-01): Earn shows "Waiting for route" and
# blocks withdrawals that would need an unwind. Optional since 5 Oct: the chain source also shows it whenever the vault's
# skewCapacity is 0 (the mainnet idle launch, PHASES 17). Set it only to force the state.
NEXT_PUBLIC_VAULT_ROUTE_PENDING=
# NEXT_PUBLIC_INDEXER_URL (above) also powers the Stats metrics dashboard (indexer only; unset ⇒ "indexer not connected").
# Labelled outside MON/USD reference chart, 1 = show the source: GeckoTerminal keyless (no key), cached 60 s server-side.
NEXT_PUBLIC_REFERENCE_CHART=
# Privy (K1): the public app ID from dashboard.privy.io. Unset ⇒ no Privy SDK in the build, injected wallet only (D6).
# Never put the Privy App Secret anywhere in this app.
NEXT_PUBLIC_PRIVY_APP_ID=
# Mera passkey wallet (LAUNCH_PLAN W1): Face ID / fingerprint login next to Privy, same passkey + address as the native
# app. The rpId is PERMANENT (a passkey can't move hosts): production meridianfi.vercel.app (chain 143), staging
# meridian-testnet.vercel.app (10143), localhost for local dev only. Must equal the page's host, else no passkey button.
# Unset = no passkey wallet in this build.
NEXT_PUBLIC_MERA_RP_ID=
# Gas sponsorship kill switch: "0" turns Privy's native sponsorship off (embedded wallets then pay their own MON).
# Unset = on. Only ever applies to Monad Testnet (10143); mainnet is never sponsored.
NEXT_PUBLIC_SPONSOR_GAS=
# Labelled outside venue, 1 = show "Perpl MON-PERP (ref)" as a chart source and a read-only "Perpl" book tab: Perpl's
# public mainnet market-data API (no key), cached server-side (4 s book, 30 s candles). Never mixed into Meridian's data.
NEXT_PUBLIC_PERPL_REFERENCE=
# Rates & Risk (K5). Server-only RPCs for /api/perpl/* (fall back to the NEXT_PUBLIC_ read RPCs above when unset).
MONAD_TESTNET_RPC_URL=
MONAD_RPC_URL=
# MFI service (docs/MFI.md §7): the MFI card, the MFI line and funding cost at the MFI. Unset ⇒ labelled empty states.
NEXT_PUBLIC_MFI_URL=
# Public alerts channel (keepers/alerts) linked from the Alerts card; unset ⇒ no link.
NEXT_PUBLIC_ALERTS_CHANNEL_URL=
