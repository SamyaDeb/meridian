# Meridian environment. Names only: never commit real values (.env is gitignored).
# Chain ids: Monad mainnet 143, testnet 10143 (ARCHITECTURE R1). RPCs come from here, never hard-coded.

# RPC (use a paid endpoint for keepers/bots: public RPCs are 25 rps and cap eth_getLogs at 100 blocks, R2)
MONAD_RPC_URL=
MONAD_TESTNET_RPC_URL=

# Hot keys (separate per role; protocol owner is the Safe 2-of-3, not a key here)
DEPLOYER_PK=
KEEPER_PK=
MM_PK=
# funding-swap market maker (MARKET=swap), its own key: passed as MM_PK to the swap MM process (RUNBOOK §4c)
SWAP_MM_PK=

# Pyth (Hermes requires an API key since 26 Aug 2026, R24). MON/USD feed id from R12.
PYTH_API_KEY=
PYTH_MON_USD_FEED_ID=0x31491744e2dbf6df7fcf4ac0820d18a609b49076d45066d3568424e62f686cd1

# Kuru Flow quote API JWT (from ws.kuru.io/api/generate-token, R19c)
KURU_FLOW_JWT=

# App / indexer
PRIVY_APP_ID=
ENVIO_API_TOKEN=

# Perpl hedge for the MM (K3, docs/PERPL_HEDGE.md). TESTNET ONLY: startup fails unless chain 10143 + testnet.perpl.xyz.
# Off unless PERPL_HEDGE=1. The key pair comes from testnet.perpl.xyz/apikeys (trade scope); never commit or paste it.
PERPL_HEDGE=0
PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_WS_URL=wss://testnet.perpl.xyz
PERPL_CHAIN_ID=10143
PERPL_MARKET_ID=64
PERPL_API_KEY=
PERPL_API_KEY_SECRET=
# hedge wallet key: only for the one-time Perpl account setup, never read by the bots
PERPL_HEDGE_WALLET_KEY=
# hedge limits (safe defaults; MON amounts, notional in USD)
HEDGE_BAND_BPS=2500
HEDGE_RESIDUAL_MON=0
HEDGE_MAX_ORDER_MON=5000
HEDGE_MAX_NOTIONAL_USD=500
HEDGE_SLIPPAGE_BPS=50
HEDGE_MAX_DIVERGENCE_BPS=300
HEDGE_MAX_DATA_AGE_MS=15000
HEDGE_MAX_REJECTS=3
HEDGE_MIN_COLLATERAL=50
HEDGE_COOLDOWN_MS=15000
HEDGE_LEVERAGE=500
# evidence log (JSONL, secrets redacted), relative to mm-bot/ where the MM runs; runs/ is gitignored
HEDGE_EVIDENCE=runs/hedge-evidence.jsonl
# optional funding-aware residual (off; sign convention still > VERIFY in docs/MFI.md §2 b)
HEDGE_FUNDING_BIAS=0
# MFI: Perpl market-data WebSocket (PERPL_WS=0 = REST polling only)
PERPL_WS=1
